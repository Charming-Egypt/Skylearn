    </div>

    <!-- ========================================== -->
    <!-- 3. EXPLORE SCREEN -->
    <!-- ========================================== -->
    <div id="screen-explore" class="screen p-5 bg-white">
        <div class="flex items-center gap-4 mb-5 mt-2">
            <button onclick="navigate('screen-home')" class="text-gray-600"><i data-lucide="chevron-left" class="w-6 h-6"></i></button>
            <h1 class="text-lg font-bold text-brand-blue">Explore Languages</h1>
            <button class="ml-auto text-gray-600"><i data-lucide="sliders-horizontal" class="w-5 h-5"></i></button>
        </div>

        <div class="search-bar mb-5">
            <i data-lucide="search" class="w-5 h-5 text-gray-400"></i>
            <input type="text" placeholder="Search languages...">
        </div>

        <div class="flex gap-2 overflow-x-auto pb-4 mb-2">
            <button class="px-4 py-1.5 bg-brand-blue text-white text-xs font-medium rounded-full whitespace-nowrap">All</button>
            <button class="px-4 py-1.5 bg-gray-100 text-gray-600 text-xs font-medium rounded-full whitespace-nowrap">German</button>
            <button class="px-4 py-1.5 bg-gray-100 text-gray-600 text-xs font-medium rounded-full whitespace-nowrap">Italian</button>
            <button class="px-4 py-1.5 bg-gray-100 text-gray-600 text-xs font-medium rounded-full whitespace-nowrap">Russian</button>
        </div>

        <div class="flex flex-col gap-4" id="explore-course-list">
