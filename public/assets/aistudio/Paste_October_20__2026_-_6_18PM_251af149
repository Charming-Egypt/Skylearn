    <!-- ========================================== -->
    <!-- 2. HOME SCREEN -->
    <!-- ========================================== -->
    <div id="screen-home" class="screen p-5 bg-[#F8FAFC]">
        <div class="flex justify-between items-center mb-5 mt-2">
