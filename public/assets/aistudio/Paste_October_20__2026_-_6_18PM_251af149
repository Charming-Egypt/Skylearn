            </div>
            <div class="flex items-center justify-between p-4 border-b border-gray-50 cursor-pointer">
                <div class="flex items-center gap-3">
                    <i data-lucide="award" class="w-5 h-5 text-gray-400"></i>
                    <span class="text-sm font-medium text-gray-700">Certificates</span>
                </div>
