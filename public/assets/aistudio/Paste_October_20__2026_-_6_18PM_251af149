    // ==========================================
    // 2. STATE & NAVIGATION
    // ==========================================
    let currentCourse = null;
    let currentLesson = null;

    function navigate(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        const target = document.getElementById(screenId);
        if(target) target.classList.add('active');

        const bottomNav = document.getElementById('bottom-nav');
        if (screenId === 'screen-onboarding' || screenId === 'screen-course-details' || screenId === 'screen-lesson') {
            bottomNav.style.display = 'none';
        } else {
            bottomNav.style.display = 'flex';
        }

        // Update bottom nav active state
        document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
        const navItems = document.querySelectorAll('.nav-item');
        if(screenId === 'screen-home') navItems[0].classList.add('active');
        if(screenId === 'screen-explore') navItems[1].classList.add('active');
        if(screenId === 'screen-learning') navItems[2].classList.add('active');
        if(screenId === 'screen-profile') navItems[4].classList.add('active');
    }

    // ==========================================
    // 3. DYNAMIC RENDERING
    // ==========================================
    function renderHome() {
        const continueContainer = document.getElementById('continue-learning-list');
        continueContainer.innerHTML = coursesData.map(course => {
            const completed = Math.floor(Math.random() * 5); // Demo progress
            return `
                <div class="min-w-[240px] bg-white p-3 rounded-2xl shadow-sm border border-gray-100 snap-start flex gap-3 cursor-pointer" onclick="openCourseDetails('${course.id}')">
                    <div class="w-12 h-12 ${course.color} rounded-xl flex items-center justify-center text-white font-bold shrink-0">${course.flag}</div>
                    <div class="flex-1">
                        <h3 class="text-sm font-bold text-gray-800 leading-tight mb-1">${course.title}</h3>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-[10px] text-gray-500">${completed}/4 Lessons</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-1.5">
                            <div class="bg-brand-blue h-1.5 rounded-full" style="width: ${completed * 25}%"></div>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderExplore() {
        const exploreContainer = document.getElementById('explore-course-list');
        exploreContainer.innerHTML = coursesData.map(course => `
            <div class="course-card p-3 flex gap-3 cursor-pointer" onclick="openCourseDetails('${course.id}')">
                <div class="w-16 h-16 ${course.color} rounded-xl flex items-center justify-center text-white font-bold text-xl shrink-0">${course.flag}</div>
                <div class="flex-1">
                    <h3 class="text-sm font-bold text-gray-800 mb-1">${course.title} - Complete Course</h3>
                    <p class="text-[11px] text-gray-500 mb-2">Language • A1-B1</p>
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-1 text-yellow-500 text-xs font-bold">
                            <i data-lucide="star" class="w-3 h-3 fill-current"></i> 4.9 (1.5k)
                        </div>
                        <span class="text-brand-blue font-bold text-sm">Free</span>
                    </div>
                </div>
            </div>
        `).join('');
    }

    function renderMyLearning() {
        const learningContainer = document.getElementById('my-learning-list');
        learningContainer.innerHTML = coursesData.map((course, index) => {
            const completed = index === 0 ? 3 : index === 1 ? 1 : 0; // Demo progress
            const percentage = (completed / 4) * 100;
            return `
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex gap-4 cursor-pointer" onclick="openCourseDetails('${course.id}')">
                    <div class="w-12 h-12 ${course.color} rounded-xl flex items-center justify-center text-white font-bold shrink-0">${course.flag}</div>
                    <div class="flex-1">
                        <h3 class="text-sm font-bold text-gray-800 mb-1">${course.title} - A1 to B1</h3>
                        <div class="flex justify-between items-center text-[11px] text-gray-500 mb-2">
                            <span>${completed}/4 Lessons</span>
                            <span class="font-bold text-brand-blue">${percentage}%</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-1.5">
                            <div class="bg-brand-blue h-1.5 rounded-full" style="width: ${percentage}%"></div>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    function openCourseDetails(courseId) {
        currentCourse = coursesData.find(c => c.id === courseId);
        if (!currentCourse) return;

        document.getElementById('detail-title').textContent = currentCourse.title;
        document.getElementById('detail-subtitle').textContent = `Language • Levels: ${currentCourse.levels.join(', ')}`;
        
        const syllabusContainer = document.getElementById('detail-syllabus');
        syllabusContainer.innerHTML = currentCourse.lessons.map((lesson, index) => `
            <li class="flex items-start gap-2 text-sm text-gray-600 cursor-pointer hover:text-brand-blue" onclick="openLesson(${index})">
                <i data-lucide="play-circle" class="w-4 h-4 text-brand-blue shrink-0 mt-0.5"></i>
                <span><strong>${lesson.level}:</strong> ${lesson.title}</span>
            </li>
        `).join('');

        navigate('screen-course-details');
    }

    function startCourse() {
        if (currentCourse && currentCourse.lessons.length > 0) {
            openLesson(0);
        }
    }

    function openLesson(lessonIndex) {
        if (!currentCourse || !currentCourse.lessons[lessonIndex]) return;
        
        currentLesson = currentCourse.lessons[lessonIndex];
        
        document.getElementById('lesson-title-display').textContent = currentLesson.title;
        document.getElementById('lesson-subtitle-display').textContent = `Level ${currentLesson.level} • ${currentCourse.title}`;
        document.getElementById('lesson-content-area').innerHTML = currentLesson.content;

        // Auto-play sample audio on open (optional)
        // const firstAudio = currentLesson.content.match(/playAudio\('([^']+)', '([^']+)'\)/);
        // if(firstAudio) playAudio(firstAudio[1], firstAudio[2]);

        navigate('screen-lesson');
        lucide.createIcons(); // Re-initialize icons for dynamic content
    }

    function playCurrentLessonAudio() {
        if (currentLesson) {
            // Extracts the first playAudio text from the HTML content for a quick preview
            const match = currentLesson.content.match(/playAudio\('([^']+)', '([^']+)'\)/);
            if (match) {
                playAudio(match[1], match[2]);
            } else {
                playAudio(currentLesson.title, currentCourse.id === 'german' ? 'de-DE' : currentCourse.id === 'italian' ? 'it-IT' : 'ru-RU');
            }
        }
    }

    // ==========================================
    // 4. TTS ENGINE (Multi-Language)
    // ==========================================
    let voices = [];
    function loadVoices() {
        voices = window.speechSynthesis.getVoices();
    }
    if (typeof speechSynthesis !== 'undefined' && speechSynthesis.onvoiceschanged !== undefined) {
        speechSynthesis.onvoiceschanged = loadVoices;
    }

    function playAudio(text, lang) {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel(); 
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = lang; // 'de-DE', 'it-IT', 'ru-RU'
            utterance.rate = 0.85; 
            
            const voice = voices.find(v => v.lang.includes(lang.split('-')[0]));
            if (voice) utterance.voice = voice;
            
            window.speechSynthesis.speak(utterance);
        } else {
            alert("Your browser doesn't support Speech Synthesis.");
        }
    }

    // ==========================================
    // 5. PWA SETUP
    // ==========================================
    function initPWA() {
        try {
            const manifest = {
                name: "SkyLearn - Language Courses",
                short_name: "SkyLearn",
                start_url: ".",
                display: "standalone",
                background_color: "#F8FAFC",
                theme_color: "#1E3A8A",
                icons: [{
                    src: "data:image/svg+xml;base64,",
                    sizes: "512x512",
                    type: "image/svg+xml"
                }]
            };
            
            const link = document.createElement('link');
            link.rel = 'manifest';
            link.href = URL.createObjectURL(new Blob([JSON.stringify(manifest)], {type: 'application/json'}));
            document.head.appendChild(link);

            if ('serviceWorker' in navigator) {
                const swCode = `
                    const CACHE_NAME = 'skylearn-lang-v1';
                    self.addEventListener('install', (e) => { self.skipWaiting(); });
                    self.addEventListener('fetch', (e) => {
                        e.respondWith(caches.match(e.request).then((response) => response || fetch(e.request)));
                    });
                `;
                navigator.serviceWorker.register(URL.createObjectURL(new Blob([swCode], {type: 'application/javascript'})));
            }
        } catch (e) {
            console.log("PWA Setup Failed", e);
        }
    }

    // ==========================================
    // 6. INITIALIZATION
    // ==========================================
    window.onload = () => {
        lucide.createIcons();
        renderHome();
        renderExplore();
        renderMyLearning();
        initPWA();
    };
</script>
