        </div>
    </div>

    <!-- ========================================== -->
    <!-- 4. COURSE DETAILS SCREEN -->
    <!-- ========================================== -->
    <div id="screen-course-details" class="screen bg-white pb-24">
        <div class="relative w-full h-56 bg-brand-blue flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="2"/></pattern></defs><rect width="100%" height="100%" fill="url(#grid)" /></svg>
            </div>
            <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center backdrop-blur-sm z-10">
                <i data-lucide="book-open" class="w-10 h-10 text-white"></i>
            </div>
            <div class="absolute top-4 left-4 right-4 flex justify-between z-20">
