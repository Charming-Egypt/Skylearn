    <div class="bottom-nav" id="bottom-nav" style="display: none;">
        <div class="nav-item active" onclick="navigate('screen-home')">
            <i data-lucide="home"></i>
            <span>Home</span>
        </div>
        <div class="nav-item" onclick="navigate('screen-explore')">
            <i data-lucide="search"></i>
            <span>Explore</span>
        </div>
        <div class="nav-item" onclick="navigate('screen-learning')">
            <i data-lucide="bookmark"></i>
            <span>My Learning</span>
        </div>
        <div class="nav-item">
            <i data-lucide="message-circle"></i>
            <span>Chat</span>
        </div>
        <div class="nav-item" onclick="navigate('screen-profile')">
            <i data-lucide="user"></i>
            <span>Profile</span>
        </div>
    </div>

</div>

<script>
    // ==========================================
    // 1. COURSE DATA (Real Curriculum A1-B1)
    // ==========================================
    const coursesData = [
        {
            id: 'german',
            title: 'German (Deutsch)',
            flag: 'DE',
            color: 'bg-[#1E3A8A]',
            levels: ['A1', 'A2', 'B1'],
            description: 'Master German from beginner to intermediate.',
            lessons: [
                {
                    level: 'A1',
                    title: 'Alphabet & Pronunciation',
                    content: `
                        <h3>Das Alphabet</h3>
                        <p>The German alphabet has 26 basic letters, plus 4 special characters: <strong>Ä, Ö, Ü</strong>, and <strong>ß</strong>.</p>
                        <p><strong>Key Rules:</strong></p>
                        <ul>
                            <li><strong>ei:</strong> sounds like "eye" (e.g., <em>ein</em>).</li>
                            <li><strong>ie:</strong> sounds like "ee" (e.g., <em>sie</em>).</li>
                            <li><strong>sch:</strong> sounds like "sh" (e.g., <em>Schule</em>).</li>
                        </ul>
