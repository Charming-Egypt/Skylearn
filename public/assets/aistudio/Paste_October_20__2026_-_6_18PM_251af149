        <div class="absolute bottom-0 left-0 w-full h-24 bg-brand-yellow rounded-t-[50%] scale-x-150 translate-y-12"></div>
        <div class="absolute bottom-0 left-0 w-full h-32 bg-blue-400 rounded-t-[50%] scale-x-150 translate-y-20 opacity-30"></div>

        <div class="w-full relative z-10 mt-auto pb-8">
            <button onclick="navigate('screen-home')" class="btn-primary mb-4 flex items-center justify-center gap-2">
                Get Started <i data-lucide="arrow-right" class="w-4 h-4"></i>
