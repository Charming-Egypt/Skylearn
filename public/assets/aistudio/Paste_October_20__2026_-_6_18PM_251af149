                </button>
                <button class="w-10 h-10 bg-white bg-opacity-20 rounded-full flex items-center justify-center text-white backdrop-blur-sm">
                    <i data-lucide="heart" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        <div class="p-5">
            <h1 class="text-xl font-bold text-brand-blue mb-1 leading-tight" id="detail-title"></h1>
            <p class="text-xs text-gray-500 mb-3" id="detail-subtitle"></p>
            
            <div class="flex items-center gap-4 mb-4">
                <div class="flex items-center gap-1 text-yellow-500 text-sm font-bold">
                    <i data-lucide="star" class="w-4 h-4 fill-current"></i> 4.9 (1.8k reviews)
                </div>
                <div class="text-brand-blue font-bold text-xl">Free</div>
            </div>

            <h2 class="font-bold text-gray-800 mb-2 mt-6">What you'll learn</h2>
            <ul class="space-y-2 mb-6" id="detail-syllabus">
                <!-- Populated dynamically -->
            </ul>

            <h2 class="font-bold text-gray-800 mb-2">Instructor</h2>
            <div class="flex items-center gap-3 mb-6 bg-gray-50 p-3 rounded-xl">
                <div class="w-10 h-10 bg-brand-blue rounded-full flex items-center justify-center text-white font-bold">SL</div>
                <div>
                    <h3 class="text-sm font-bold text-gray-800">SkyLearn Team</h3>
                    <p class="text-[11px] text-gray-500">Language Experts</p>
                </div>
            </div>

            <div class="fixed bottom-0 left-0 w-full bg-white p-4 border-t border-gray-100 max-w-[420px] left-1/2 -translate-x-1/2 z-50">
                <button onclick="startCourse()" class="btn-primary">Start Learning</button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- 5. LESSON SCREEN (Dynamic Content) -->
    <!-- ========================================== -->
    <div id="screen-lesson" class="screen bg-white pb-0">
        <div class="relative w-full h-48 bg-[#1E3A8A] flex flex-col justify-center items-center p-4 text-center">
            <h1 class="text-white text-xl font-bold mb-2" id="lesson-title-display">Lesson Title</h1>
            <p class="text-blue-200 text-sm mb-4" id="lesson-subtitle-display">Level</p>
            <button class="bg-white text-brand-blue px-6 py-2 rounded-full font-bold flex items-center gap-2 shadow-lg" onclick="playCurrentLessonAudio()">
                <i data-lucide="volume-2" class="w-5 h-5"></i> Listen
            </button>
            <div class="absolute top-4 left-4 right-4 flex justify-between text-white z-20">
                <button onclick="navigate('screen-course-details')"><i data-lucide="chevron-left" class="w-7 h-7"></i></button>
            </div>
        </div>

        <div class="p-5 flex-1 overflow-y-auto">
            <div class="flex border-b border-gray-200 mb-4">
                <button class="pb-2 px-4 text-sm font-bold text-brand-blue border-b-2 border-brand-blue">Notes</button>
                <button class="pb-2 px-4 text-sm font-medium text-gray-500">Exercises</button>
            </div>
            <div class="lesson-content" id="lesson-content-area">
                <!-- Lesson content will be injected here -->
            </div>
        </div>
        
        <div class="p-4 border-t border-gray-100 bg-white">
            <button onclick="navigate('screen-learning')" class="btn-primary flex justify-center items-center gap-2">Mark as Complete & Next</button>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- 6. MY LEARNING SCREEN -->
    <!-- ========================================== -->
    <div id="screen-learning" class="screen p-5 bg-[#F8FAFC]">
        <h1 class="text-lg font-bold text-brand-blue mb-5 mt-2">My Learning</h1>

        <div class="flex gap-2 mb-6">
            <button class="px-4 py-2 bg-brand-blue text-white text-xs font-medium rounded-full">In Progress</button>
            <button class="px-4 py-2 bg-white text-gray-600 text-xs font-medium rounded-full shadow-sm">Completed</button>
            <button class="px-4 py-2 bg-white text-gray-600 text-xs font-medium rounded-full shadow-sm">Saved</button>
        </div>

        <div class="space-y-4" id="my-learning-list">
