        </div>
    </div>

    <!-- ========================================== -->
    <!-- 7. PROFILE SCREEN -->
    <!-- ========================================== -->
    <div id="screen-profile" class="screen p-5 bg-[#F8FAFC]">
        <div class="flex justify-between items-center mb-6 mt-2">
            <h1 class="text-lg font-bold text-brand-blue">Profile</h1>
            <button class="text-gray-600"><i data-lucide="settings" class="w-5 h-5"></i></button>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center mb-6">
            <div class="w-20 h-20 bg-brand-blue rounded-full flex items-center justify-center text-white text-2xl font-bold mb-3 border-4 border-blue-100">
                SL
            </div>
            <h2 class="text-lg font-bold text-gray-800">SkyLearner</h2>
            <p class="text-xs text-gray-500">Learning today, leading tomorrow</p>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-100 text-center">
                <p class="text-lg font-bold text-brand-blue">3</p>
                <p class="text-[10px] text-gray-500">Languages</p>
            </div>
            <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-100 text-center">
                <p class="text-lg font-bold text-brand-blue">24</p>
                <p class="text-[10px] text-gray-500">Lessons</p>
            </div>
            <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-100 text-center">
