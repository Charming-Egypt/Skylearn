                <p class="text-[10px] text-gray-500">Hours</p>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 mb-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-sm font-bold text-gray-800">My Progress</h3>
                <span class="text-xs text-brand-blue font-semibold">View All</span>
            </div>
            <div class="flex items-center gap-4">
                <div class="relative w-16 h-16 flex items-center justify-center">
                    <svg class="w-16 h-16 transform -rotate-90">
                        <circle cx="32" cy="32" r="28" stroke="#E2E8F0" stroke-width="6" fill="none" />
                        <circle cx="32" cy="32" r="28" stroke="#1E3A8A" stroke-width="6" fill="none" stroke-dasharray="176" stroke-dashoffset="44" stroke-linecap="round" />
                    </svg>
                    <span class="absolute text-xs font-bold text-brand-blue">75%</span>
                </div>
                <div class="flex-1">
                    <p class="text-xs font-bold text-gray-700 mb-1">Overall Progress</p>
                    <div class="w-full bg-gray-100 rounded-full h-1.5">
                        <div class="bg-brand-blue h-1.5 rounded-full" style="width: 75%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="flex items-center justify-between p-4 border-b border-gray-50 cursor-pointer">
                <div class="flex items-center gap-3">
                    <i data-lucide="book-open" class="w-5 h-5 text-gray-400"></i>
                    <span class="text-sm font-medium text-gray-700">My Courses</span>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            </div>
            <div class="flex items-center justify-between p-4 border-b border-gray-50 cursor-pointer">
                <div class="flex items-center gap-3">
                    <i data-lucide="bookmark" class="w-5 h-5 text-gray-400"></i>
                    <span class="text-sm font-medium text-gray-700">Saved Courses</span>
                </div>
