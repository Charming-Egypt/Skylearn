<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SkyLearn - Language Courses</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons (Lucide) -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #F8FAFC;
            color: #1E293B;
            -webkit-tap-highlight-color: transparent;
            overflow: hidden;
        }

        .app-container {
            width: 100%;
            max-width: 420px;
            height: 100vh;
            margin: 0 auto;
            background-color: #ffffff;
            position: relative;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        /* Screen Management */
        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #F8FAFC;
            display: none;
            flex-direction: column;
            overflow-y: auto;
            overflow-x: hidden;
            padding-bottom: 70px;
            transition: opacity 0.3s ease-in-out;
        }
        .screen.active {
            display: flex;
            opacity: 1;
        }

        /* Hide scrollbar */
        ::-webkit-scrollbar { display: none; }

        /* Custom Colors */
        .text-brand-blue { color: #1E3A8A; }
        .bg-brand-blue { background-color: #1E3A8A; }
        .text-brand-yellow { color: #FCD34D; }
        .bg-brand-yellow { background-color: #FCD34D; }
        
        /* Bottom Nav */
        .bottom-nav {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 70px;
            background: white;
            border-top: 1px solid #E2E8F0;
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 50;
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #94A3B8;
            font-size: 10px;
            font-weight: 500;
            gap: 4px;
            cursor: pointer;
            transition: color 0.2s;
        }
        .nav-item.active { color: #1E3A8A; }
        .nav-item svg { width: 20px; height: 20px; }
        .nav-item.active svg { stroke-width: 2.5; }

        /* Inputs & Buttons */
        .search-bar {
            background-color: #F1F5F9;
            border-radius: 12px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .search-bar input {
            background: transparent;
            border: none;
            outline: none;
            width: 100%;
            font-size: 14px;
        }

        .btn-primary {
            background-color: #FCD34D;
            color: #1E3A8A;
            font-weight: 600;
            border-radius: 12px;
            padding: 14px;
            width: 100%;
            text-align: center;
            transition: background 0.2s;
        }
        .btn-primary:active { background-color: #EAB308; }

        /* Cards */
        .course-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            margin-bottom: 16px;
        }

        /* Onboarding specific */
        .onboarding-illustration {
            width: 100%;
            height: 250px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Lesson Content Styles */
        .lesson-content h3 { font-weight: 700; color: #1E3A8A; margin-top: 16px; margin-bottom: 8px; }
        .lesson-content p { font-size: 14px; color: #475569; line-height: 1.6; margin-bottom: 12px; }
        .lesson-content ul { list-style-type: disc; padding-left: 20px; margin-bottom: 12px; }
        .lesson-content li { font-size: 14px; color: #475569; margin-bottom: 6px; }
        .speak-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px; border-radius: 50%;
            background-color: #E0F2FE; color: #0284C7;
            cursor: pointer; margin-right: 6px; border: none;
        }
        .speak-btn:active { transform: scale(0.95); }
    </style>
</head>
<body>

<div class="app-container" id="app">
    
    <!-- ========================================== -->
    <!-- 1. ONBOARDING SCREEN -->
    <!-- ========================================== -->
    <div id="screen-onboarding" class="screen active bg-white items-center justify-center p-6 text-center">
        <div class="mb-8 flex flex-col items-center">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#1E3A8A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-4"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <h1 class="text-3xl font-bold text-brand-blue">SkyLearn</h1>
            <p class="text-gray-500 text-sm mt-1">Learn Languages, Build Tomorrow</p>
        </div>

        <div class="onboarding-illustration mb-8">
            <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="100" cy="100" r="80" fill="#EFF6FF"/>
                <rect x="60" y="80" width="80" height="60" rx="8" fill="#1E3A8A"/>
                <rect x="70" y="90" width="60" height="40" rx="4" fill="#FCD34D"/>
